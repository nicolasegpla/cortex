APP_ENV=development

# Comma-separated list of frontend origins allowed by CORS.
# Keep localhost for desktop dev. For LAN/mobile testing, add the host machine's
# LAN IP frontend URL (e.g. http://192.168.1.42:5173).
CORS_ORIGINS=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_ANON_KEY=your-anon-key
# URL where invited users land after clicking the Supabase activation email.
# Must match an allowed redirect URL in Supabase Auth > URL Configuration.
SUPABASE_INVITE_REDIRECT_URL=http://localhost:5173/auth/invite

# Resend configuration for application-controlled invite emails.
# Get your API key at https://resend.com/api-keys.
# The from address must be a verified domain or address in your Resend account.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=invites@your-domain.com

ENCRYPTION_KEY=your-fernet-key-base64-encoded

# n8n chat proxy configuration.
# The backend POSTs { message, sessionId } to this webhook and maps the
# { ok: true, answer } response to { answer } for the frontend.
# Optional: if omitted (or left empty), POST /chat/n8n returns 503 instead of
# blocking backend startup.
N8N_CHAT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/chat
# Optional: timeout in seconds for the outbound n8n request (default: 60).
N8N_CHAT_TIMEOUT_SECONDS=60
# Required when N8N_CHAT_WEBHOOK_URL is configured: token sent to n8n as an
# Authorization: Bearer <token> header. If omitted, POST /chat/n8n returns 503.
N8N_CHAT_AUTH_TOKEN=your-n8n-auth-token
