# Copy to `.env` for local development and replace values as needed.
# For Netlify deploys, set production values in the site environment variables panel.

# Backend URL seen by the browser. Keep localhost for desktop dev.
# For LAN/mobile testing, set this to the host machine's LAN IP (e.g. http://192.168.1.42:8000).
VITE_API_BASE_URL=http://localhost:8000

# Optional: host used by Vite's HMR websocket when testing from another device.
# Only needed if LAN autodetection fails; usually left empty.
# VITE_DEV_HOST=192.168.1.42

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
